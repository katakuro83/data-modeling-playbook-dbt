Data Vault models schema doc
version: 2

models:
  - name: hub_customer
    description: "Data Vault Hub: unique customer business keys only."
    columns:
      - name: customer_hk
        tests: [unique, not_null]

  - name: hub_product
    description: "Data Vault Hub: unique product business keys only."
    columns:
      - name: product_hk
        tests: [unique, not_null]

  - name: hub_order
    description: "Data Vault Hub: unique order business keys only."
    columns:
      - name: order_hk
        tests: [unique, not_null]

  - name: link_order_customer
    description: "Data Vault Link: relationship between an order and the customer who placed it."
    columns:
      - name: order_customer_lk
        tests: [unique, not_null]
      - name: order_hk
        tests:
          - relationships:
              to: ref('hub_order')
              field: order_hk
      - name: customer_hk
        tests:
          - relationships:
              to: ref('hub_customer')
              field: customer_hk

  - name: link_order_product
    description: "Data Vault Link: relationship between an order and each product on it (line item grain)."
    columns:
      - name: order_product_lk
        tests: [unique, not_null]
      - name: order_hk
        tests:
          - relationships:
              to: ref('hub_order')
              field: order_hk
      - name: product_hk
        tests:
          - relationships:
              to: ref('hub_product')
              field: product_hk

  - name: sat_customer
    description: "Data Vault Satellite: historized descriptive attributes for customers."
    columns:
      - name: customer_hk
        tests:
          - relationships:
              to: ref('hub_customer')
              field: customer_hk

  - name: sat_product
    description: "Data Vault Satellite: historized descriptive attributes for products."
    columns:
      - name: product_hk
        tests:
          - relationships:
              to: ref('hub_product')
              field: product_hk

  - name: sat_order
    description: "Data Vault Satellite: historized descriptive attributes for orders (e.g. status changes over time)."
    columns:
      - name: order_hk
        tests:
          - relationships:
              to: ref('hub_order')
              field: order_hk
