Create Data Vault link models
bash

cd /home/data-modeling-playbook-dbt/dbt_project/models/data_vault

cat > link_order_customer.sql << 'EOF'
-- Data Vault: Link -- records the relationship/transaction between an
-- order and a customer. Links capture WHICH keys are related, not
-- descriptive attributes about them.
select distinct
    {{ dbt_utils.generate_surrogate_key(['o.order_id', 'o.customer_id']) }} as order_customer_lk,
    {{ dbt_utils.generate_surrogate_key(['o.order_id']) }}    as order_hk,
    {{ dbt_utils.generate_surrogate_key(['o.customer_id']) }} as customer_hk,
    current_timestamp as load_date,
    'orders_system' as record_source
from {{ ref('stg_orders') }} o
EOF

cat > link_order_product.sql << 'EOF'
-- Data Vault: Link -- records that a given product appeared on a given
-- order (order line grain relationship), one row per order_item
select distinct
    {{ dbt_utils.generate_surrogate_key(['oi.order_id', 'oi.product_id', 'oi.order_item_id']) }} as order_product_lk,
    {{ dbt_utils.generate_surrogate_key(['oi.order_id']) }}   as order_hk,
    {{ dbt_utils.generate_surrogate_key(['oi.product_id']) }} as product_hk,
    oi.order_item_id,
    current_timestamp as load_date,
    'orders_system' as record_source
from {{ ref('stg_order_items') }} oi
EOF

