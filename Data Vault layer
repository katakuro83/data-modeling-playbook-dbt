Create Data Vault satellite models
bash

cd /home/data-modeling-playbook-dbt/dbt_project/models/data_vault

cat > sat_customer.sql << 'EOF'
-- Data Vault: Satellite -- descriptive attributes for the customer hub,
-- timestamped and hashed so any future change lands as a NEW row,
-- never an overwrite. This is what gives Data Vault built-in history.
select
    {{ dbt_utils.generate_surrogate_key(['customer_id']) }} as customer_hk,
    first_name,
    last_name,
    email,
    country,
    signup_date,
    {{ dbt_utils.generate_surrogate_key(['first_name', 'last_name', 'email', 'country']) }} as hash_diff,
    current_timestamp as load_date,
    'orders_system' as record_source
from {{ ref('stg_customers') }}
EOF

cat > sat_product.sql << 'EOF'
-- Data Vault: Satellite for product attributes
select
    {{ dbt_utils.generate_surrogate_key(['p.product_id']) }} as product_hk,
    p.product_name,
    c.category_name as category,
    p.unit_price,
    p.is_active,
    {{ dbt_utils.generate_surrogate_key(['p.product_name', 'c.category_name', 'p.unit_price', 'p.is_active']) }} as hash_diff,
    current_timestamp as load_date,
    'orders_system' as record_source
from {{ ref('stg_products') }} p
left join {{ ref('stg_categories') }} c
    on p.category_id = c.category_id
EOF

cat > sat_order.sql << 'EOF'
-- Data Vault: Satellite for order attributes (e.g., order_status changing
-- over time -- placed -> shipped -> delivered -- would each be a new row
-- in a real incremental load, preserving the full status history)
select
    {{ dbt_utils.generate_surrogate_key(['order_id']) }} as order_hk,
    order_date,
    order_status,
    {{ dbt_utils.generate_surrogate_key(['order_date', 'order_status']) }} as hash_diff,
    current_timestamp as load_date,
    'orders_system' as record_source
from {{ ref('stg_orders') }}
EOF

